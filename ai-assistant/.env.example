# ===== JHS AI Knowledge Assistant (ai-assistant/) =====
APP_ENV=production
PORT=8100
ALLOWED_ORIGINS=https://jhsassociates.in
# Protects admin + webhook endpoints (X-API-Key header). REQUIRED for admin endpoints to work.
ADMIN_API_KEY=change-me-long-random

# OpenAI
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1
ROUTER_MODEL=gpt-4.1-mini
RERANK_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024        # must equal the Pinecone index dimension

# Pinecone (a dedicated index; NOT the legacy chatbot's jhs-website-chatbot)
PINECONE_API_KEY=
AI_PINECONE_INDEX=jhs-assistant-vectors

# MongoDB: SOURCE_DB is read through the public allowlist; the assistant writes only to APP_DB.
MONGO_URI=
MONGO_DB_NAME=JHS_website
APP_DB_NAME=JHS_ai_assistant

SITE_BASE_URL=https://jhsassociates.in
CONTACT_EMAIL=connect@jhsassociates.in

# Worker: incremental reconcile interval
SYNC_INTERVAL_MINUTES=360

# Tunables (defaults shown)
# CHUNK_MAX_TOKENS=700
# CHUNK_OVERLAP_TOKENS=100
# RETRIEVAL_TOP_K=12
# FINAL_CONTEXT_CHUNKS=6
# MIN_DENSE_SCORE=0.30
# RERANK_ENABLED=true
# HISTORY_WINDOW_MESSAGES=6
# RATE_LIMIT_PER_MINUTE=15
