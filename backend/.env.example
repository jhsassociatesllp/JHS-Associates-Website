MONGODB_URL=mongodb://localhost:27017/
# MONGODB_URL=mongodb://45.198.225.149:27017/
DATABASE_NAME=JHS_website

# Outlook / Microsoft 365 SMTP — used by app/services/email_service.py to
# send HR notification + user acknowledgement emails (Contact, Alumni,
# Career applications, Appointments). Leave blank to skip sending (logged
# as a warning, nothing else breaks).
# If auth fails: enable "SMTP AUTH" for this mailbox in the Microsoft 365
# admin center, and use an App Password here if MFA is enabled.
HR_NOTIFICATION_EMAIL=hr@jhsassociates.in
SENDER_EMAIL=your-outlook-account@jhsassociates.in
SENDER_NAME=JHS Associates
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your-outlook-account@jhsassociates.in
SMTP_PASSWORD=

# Google Sign-In (career applicants apply flow). Create an OAuth 2.0 Client
# ID (Web application) in Google Cloud Console and add this site's origin
# (e.g. https://jhsassociates.in and http://localhost:5173) under
# "Authorized JavaScript origins". The same value must be set as
# VITE_GOOGLE_CLIENT_ID in the frontend's .env.
GOOGLE_CLIENT_ID=
