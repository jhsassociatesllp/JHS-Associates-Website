# ===================================================================
# Chatbot Backend Environment Variables (.env)
# ===================================================================

# OpenAI API Key (Required for embeddings text-embedding-3-small and chat gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Database Configuration (Recommended for Vector Storage)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=jhs-website-chatbot

# Website Sitemap URL (Used by crawler.js)
SITE_SITEMAP_URL=https://jhsassociates.in/sitemap.xml

# MongoDB Database Connection (Used by ingest-extra.js & live counts)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=JHS_website
MONGO_COLLECTION=knowledge_base

# Server Port & Security Configuration
PORT=3001
ALLOWED_ORIGIN=https://jhsassociates.in
API_KEY=your_optional_secret_api_key_for_external_callers

# Tier 3 Scheduler Refresh Settings
AUTO_REFRESH_HOURS=24
AUTO_REFRESH_ON_START=0
