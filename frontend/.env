VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=http://localhost:8000/api
VITE_IMAGE_BASE=/Uploads/images

# Website content chatbot (separate Node.js service — see chatbot-backend/).
# Proxied through vite.config.ts's '/chatbot-api' entry in dev; in production
# point this at wherever that service is actually reachable (e.g. an Nginx
# location block proxying to it, same pattern as VITE_API_BASE_URL above).
VITE_CHATBOT_API_BASE_URL=/chatbot-api
# VITE_IMAGE_BASE=http://45.198.225.149:9025/Uploads

# Google Sign-In client ID used on the Careers "Apply" form. Must match
# GOOGLE_CLIENT_ID in the backend's .env (same OAuth 2.0 Web client).
VITE_GOOGLE_CLIENT_ID=348191534170-85p1v7q029bti6p7olm88nuro5mr9l4h.apps.googleusercontent.com
