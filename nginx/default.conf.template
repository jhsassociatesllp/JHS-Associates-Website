# Gateway in front of the website and the API. ${APP_ENV} is filled in by the nginx image
# (templates in /etc/nginx/templates are processed with envsubst when the container starts).

# Staging must never be indexed by search engines (audit SEC-01). Production stays indexable.
map "${APP_ENV}" $jhs_noindex {
    default "";
    staging "noindex, nofollow, noarchive";
}

map "${APP_ENV}" $jhs_is_staging {
    default 0;
    staging 1;
}

# ── Rate limits (edge): admin sign-in from the main site's address, and a ceiling on API calls per visitor. ──
limit_req_zone $binary_remote_addr zone=jhs_site_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=jhs_site_api:10m rate=900r/m;
limit_req_status 429;

server {

    listen 80;

    # Count the real visitor, not the proxies in front of us (Docker network, aaPanel on the same server, Cloudflare).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from ::1;
    set_real_ip_from fc00::/7;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Everything is small by default; only the routes that really take files are allowed more.
    client_max_body_size 64k;

    # An empty value means nginx sends no header at all (production).
    add_header X-Robots-Tag $jhs_noindex always;

    location = /robots.txt {
        if ($jhs_is_staging) {
            add_header Content-Type text/plain;
            add_header X-Robots-Tag $jhs_noindex always;
            return 200 "User-agent: *\nDisallow: /\n";
        }
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://frontend:80;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Admin sign-in through this address: same strict limit as on the admin panel.
    location ~ ^/api/admin/login(-form)?$ {
        limit_req zone=jhs_site_login burst=5 nodelay;
        proxy_pass http://backend:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }

    location /api/ {
        limit_req zone=jhs_site_api burst=150 nodelay;

        proxy_pass http://backend:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }

    # Résumé upload: an 8 MB PDF plus the form fields.
    location ~ ^/api/careers/(applications/upload|ats-check)$ {

        client_max_body_size 9m;

        proxy_pass http://backend:8000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 60s;
    }
}
